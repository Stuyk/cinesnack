{
  "name": "cinesnack",
  "productName": "CineSnack",
  "version": "1.0.0",
  "description": "Video editor that records or opens any clip, trims it, and exports an MP4 under 50 MB (or 10/500) with audio, copied straight to your clipboard.",
  "main": "./out/main/index.js",
  "author": "Stuyk",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/stuyk/cinesnack.git"
  },
  "homepage": "https://github.com/stuyk/cinesnack",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -wl",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "assets": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "lucide-solid": "^1.44.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.7.4",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static",
    "esbuild"
  ],
  "keywords": [
    "video",
    "compressor",
    "screen-recorder",
    "ffmpeg",
    "electron",
    "clipboard",
    "trim",
    "video-editor",
    "share"
  ]
}
